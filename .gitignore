# the phone's own firmware, pulled into fw-*/ by pull-firmware.sh (the vendor's)
fw-*/
# the phone's own device tree (the phone's; only its numbers are quoted, never the tree)
*.dtb
device-tree.dtb
# the loader's build output
mtkloader/*.o
mtkloader/*.bin
# the headers build.sh makes at build time and that must never be committed
mtkloader/touchfw.h
mtkloader/font8x16.h
mtkloader/gpufw.h
# the runs' logs
logs/
*.log
fbshot.png
# the XNU payload and the system image
*.packfs
xnusys*
# the payload and the flashable boot image the run builds
build-root.apfs
build-payload.bin
xnu-flashed-slot_a.img
# the phone's own boot image, pulled off the phone (backup/): the vendor's
backup/
# the XNU identity, made from the user's own IPSW (identity.h)
xnuloader/identity.h
# the iOS firmware out of Apple's archive (tools/fetch-ios.sh): never in the repository
refs/ios/
# the scratch directory the build and the fetch use: never /tmp, which is a RAM-backed tmpfs
refs/.tmp/
# python's byte-cache
__pycache__/
# the phone-side programs this port builds (tools/build-userland.sh)
userland/obj/
build-host/
.antumbra_state
# private local archive made before public-history cleanup
local-private/
# locally built kernel; public tree contains source and patch records only
mach.development.mt6893
# Claude Code's local worktrees and session files
.claude/
# macOS
.DS_Store
